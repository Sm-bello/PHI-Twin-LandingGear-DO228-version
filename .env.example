# PHI-Twin / AeroTwin PostgreSQL Configuration
# Copy this file to `.env` and fill in your local PostgreSQL password.
AEROTWIN_DB_NAME=project_db
AEROTWIN_DB_USER=postgres
AEROTWIN_DB_PASSWORD=your_postgres_password
AEROTWIN_DB_HOST=localhost
AEROTWIN_DB_PORT=5432

# Optional FlightGear UDP Overrides
AEROTWIN_FG_HOST=127.0.0.1
AEROTWIN_FG_LISTEN_PORT=15000
AEROTWIN_FG_SEND_PORT=15001
